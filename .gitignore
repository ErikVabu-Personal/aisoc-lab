# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
crash.*.log

# Local tfvars (contains secrets)
terraform.tfvars
*.auto.tfvars

# Local config (contains secrets — admin password, user roster, etc).
