# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
crash.*.log

# Local tfvars (contains secrets)
terraform.tfvars
*.auto.tfvars

# Local config (contains secrets — admin password, user roster, etc).
# Copy aisoc.config.example -> aisoc.config and edit; aisoc_demo.sh
# sources it automatically if present.
/aisoc.config

# OS
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc


# Generated at deploy time — per-phase Python venvs (each also self-ignores via
# its own .venv/.gitignore) and the agent-roster slug file the Phase-2
# agent-deploy script writes.
terraform/*/.venv/
terraform/2-deploy-aisoc/agents/roster.slugs.txt

# Vendored GOAD (Orange Cyberdefense, GPL-3.0 — see GOAD/AISOC_VENDORED.md). Its own
# GOAD/.gitignore + the Terraform/venv rules above cover its runtime state
# (workspace/, .terraform/, *.tfstate, ssh keys). This is the one extra our
# region/size prep (scripts/goad_azure_prep.py) leaves behind.
GOAD/**/*.bak-*
