# sources it automatically if present.
/aisoc.config

# OS
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc


# Generated at deploy time — per-phase Python venvs (each also self-ignores via
# its own .venv/.gitignore) and the agent-roster slug file the Phase-2
# agent-deploy script writes.
terraform/*/.venv/
terraform/2-deploy-aisoc/agents/roster.slugs.txt
