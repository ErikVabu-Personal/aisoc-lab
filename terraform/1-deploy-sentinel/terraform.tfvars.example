# Rename to terraform.tfvars and override values as needed.
# Every variable has a sensible default, so an empty tfvars applies cleanly —
# override only what you want to change.

# --- Sentinel workspace (Phase 1) ---
azure_location      = "westus" # West US
resource_group_name = "aisoc-demo"
workspace_name      = "law-sentinel-test"

# Microsoft Sentinel on the workspace (default true).
# sentinel_enabled = true

# Create the Windows Event Log Data Collection Rule (Application/System/Sysmon +
# Security) that the GOAD hosts attach to in 4-onboard-goad. Its id is exported
# as `dcr_id`. Leave true unless you are onboarding no Windows hosts.
# enable_windows_event_logs = true

# OpenRouter (optional) — prefer leaving null and setting the Key Vault secret
# manually after apply.
# openrouter_api_key = "sk-or-v1-..."

# --- Demo target app: Maison Miró (intentionally-vulnerable store, Flask on ACA) ---
# Default uses :latest; for deterministic demos pin a commit SHA tag from GHCR.
# maison_image = "ghcr.io/erikvabu-personal/aisoc-maison-miro:<GITHUB_SHA>"
# soc_key      = "soc-demo-key"     # X-SOC-Key for Maison's /soc/* API (sensitive)
# soc_armed    = "1"                # "0" to demo the no-SOC catastrophe
# sign_secret  = "..."              # HMAC key for forged-session detection (sensitive)
