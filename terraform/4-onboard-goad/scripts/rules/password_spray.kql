SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID in (4625, 4771)                  // logon failure / Kerberos pre-auth failure
| where TargetUserName !endswith "$"
| summarize DistinctAccounts = dcount(TargetUserName),
            Attempts = count(),
            Accounts = make_set(TargetUserName, 40),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
        by IpAddress
| where DistinctAccounts >= 5                     // one source, many accounts = spray
| extend timestamp = LastSeen
