SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4768                           // Kerberos TGT (AS-REQ) requested
| where TicketEncryptionType == "0x17"            // RC4-HMAC
| where PreAuthType == "0"                         // pre-authentication NOT required = AS-REP roastable
| where TargetUserName !endswith "$"
| summarize RequestCount = count(),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
        by TargetUserName, IpAddress
| extend timestamp = LastSeen
